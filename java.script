/* =========================================
   2. MENGAMBIL ELEMEN HTML
   ========================================= */

// Menghubungkan JavaScript dengan bagian website.
const searchInput = document.getElementById("search-input");
const categoryList = document.getElementById("category-list");
const maxPriceSelect = document.getElementById("max-price");
const menuGrid = document.getElementById("menu-grid");
const menuCount = document.getElementById("menu-count");
const emptyState = document.getElementById("empty-state");
const resetButton = document.getElementById("reset-button");

// Kategori yang sedang dipilih.
let activeCategory = "Semua";


/* =========================================
   3. FORMAT HARGA RUPIAH
   ========================================= */

// Mengubah angka menjadi format harga Rupiah.
// Contoh: 18000 menjadi Rp18.000.
function formatRupiah(price) {
  return new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0
  }).format(price);
}


/* =========================================
   4. MEMBUAT TOMBOL KATEGORI
   ========================================= */

// Kategori dibuat otomatis berdasarkan data menu.
function renderCategories() {
  const categories = [
    "Semua",
    ...new Set(menus.map(menu => menu.category))
  ];

  categoryList.replaceChildren();

  categories.forEach(category => {
    const button = document.createElement("button");

    button.type = "button";
    button.className = "category-button";
    button.textContent = category;

    // Tandai kategori yang sedang aktif.
    const isActive = category === activeCategory;

    button.classList.toggle("active", isActive);
    button.setAttribute("aria-pressed", String(isActive));

    // Ketika kategori diklik, tampilkan menu yang sesuai.
    button.addEventListener("click", () => {
      activeCategory = category;
      renderCategories();
      filterMenus();
    });

    categoryList.appendChild(button);
  });
}


/* =========================================
   5. MEMBUAT KARTU MENU
   ========================================= */

// Membuat tampilan satu menu secara otomatis.
function createMenuCard(menu) {
  const card = document.createElement("article");
  card.className = "menu-card";

  // Area foto menu.
  const imageWrap = document.createElement("div");
  imageWrap.className = "menu-image-wrap";

  const image = document.createElement("img");
  image.className = "menu-image";
  image.src = menu.image;
  image.alt = menu.name;
  image.loading = "lazy";

  // Jika foto gagal dimuat, tampilkan penggantinya.
  image.addEventListener("error", () => {
    image.removeAttribute("src");
    image.alt = "Foto menu tidak tersedia";
    imageWrap.classList.add("image-fallback");
  }, { once: true });

  // Label tersedia atau habis.
  const status = document.createElement("span");
  status.className = "status-badge";
  status.textContent = menu.available ? "Tersedia" : "Habis";

  if (!menu.available) {
    status.classList.add("unavailable");
  }

  imageWrap.append(image, status);

  // Area informasi makanan.
  const body = document.createElement("div");
  body.className = "menu-card-body";

  const category = document.createElement("p");
  category.className = "menu-category";
  category.textContent = menu.category;

  const name = document.createElement("h3");
  name.className = "menu-name";
  name.textContent = menu.name;

  const description = document.createElement("p");
  description.className = "menu-description";
  description.textContent = menu.description;

  // Area harga dan ketersediaan.
  const footer = document.createElement("div");
  footer.className = "menu-card-footer";

  const price = document.createElement("span");
  price.className = "menu-price";
  price.textContent = formatRupiah(menu.price);

  const stock = document.createElement("span");
  stock.className = "menu-stock";
  stock.textContent = menu.available
    ? "Siap dipesan"
    : "Stok sedang habis";

  footer.append(price, stock);
  body.append(category, name, description, footer);
  card.append(imageWrap, body);

  return card;
}


/* =========================================
   6. MENAMPILKAN DAFTAR MENU
   ========================================= */

// Memasukkan semua kartu menu ke halaman.
function renderMenus(menuData) {
  menuGrid.replaceChildren();

  // Perbarui jumlah menu yang tampil.
  menuCount.textContent = `${menuData.length} menu`;

  // Jika tidak ada hasil, tampilkan pesan.
  if (menuData.length === 0) {
    emptyState.hidden = false;
    return;
  }

  emptyState.hidden = true;

  const fragment = document.createDocumentFragment();

  menuData.forEach(menu => {
    fragment.appendChild(createMenuCard(menu));
  });

  menuGrid.appendChild(fragment);
}


/* =========================================
   7. PENCARIAN DAN FILTER MENU
   ========================================= */

// Menyaring menu berdasarkan kata, kategori, dan harga.
function filterMenus() {
  const keyword = searchInput.value
    .trim()
    .toLocaleLowerCase("id-ID");

  const selectedPrice = maxPriceSelect.value;

  const filteredMenus = menus.filter(menu => {
    // Mencari nama, deskripsi, atau kategori.
    const searchableText =
      `${menu.name} ${menu.description} ${menu.category}`
        .toLocaleLowerCase("id-ID");

    const matchesSearch = searchableText.includes(keyword);

    // Memeriksa apakah kategori cocok.
    const matchesCategory =
      activeCategory === "Semua" ||
      menu.category === activeCategory;

    // Memeriksa apakah harga sesuai batas.
    const matchesPrice =
      selectedPrice === "all" ||
      menu.price <= Number(selectedPrice);

    // Menu tampil jika semua filter cocok.
    return matchesSearch && matchesCategory && matchesPrice;
  });

  renderMenus(filteredMenus);
}


/* =========================================
   8. TOMBOL RESET
   ========================================= */

// Mengembalikan seluruh filter ke kondisi awal.
function resetFilters() {
  searchInput.value = "";
  maxPriceSelect.value = "all";
  activeCategory = "Semua";

  renderCategories();
  filterMenus();
}


/* =========================================
   9. EVENT WEBSITE
   ========================================= */

// Pencarian berjalan saat pengguna mengetik.
searchInput.addEventListener("input", filterMenus);

// Filter harga berjalan ketika pilihan berubah.
maxPriceSelect.addEventListener("change", filterMenus);

// Reset berjalan ketika tombol diklik.
resetButton.addEventListener("click", resetFilters);


/* =========================================
   10. MENAMPILKAN MENU PERTAMA KALI
   ========================================= */

// Menampilkan kategori dan 18 menu saat halaman dibuka.
renderCategories();
filterMenus();
