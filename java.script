/* =========================================
   2. MENGAMBIL ELEMEN HTML
   ========================================= */

// Menghubungkan JavaScript dengan bagian HTML.
const searchInput = document.getElementById("search-input");
const categoryList = document.getElementById("category-list");
const maxPriceSelect = document.getElementById("max-price");
const menuGrid = document.getElementById("menu-grid");
const menuCount = document.getElementById("menu-count");
const emptyState = document.getElementById("empty-state");
const resetButton = document.getElementById("reset-button");

// Kategori yang sedang dipilih.
// "Semua" berarti menampilkan semua kategori.
let activeCategory = "Semua";


/* =========================================
   3. FORMAT HARGA
   ========================================= */

// Mengubah angka menjadi format rupiah.
// Contoh: 18000 menjadi Rp18.000.
function formatRupiah(price) {
  return new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0
  }).format(price);
}


/* =========================================
   4. MEMBUAT TOMBOL KATEGORI
   ========================================= */

function renderCategories() {
  // Mengambil kategori unik dari data menu.
  const categories = [
    "Semua",
    ...new Set(menus.map((menu) => menu.category))
  ];

  // Menghapus tombol kategori lama sebelum membuat ulang.
  categoryList.replaceChildren();

  categories.forEach((category) => {
    const button = document.createElement("button");

    button.type = "button";
    button.className = "category-button";
    button.textContent = category;

    // Menandai kategori yang sedang aktif.
    if (category === activeCategory) {
      button.classList.add("active");
      button.setAttribute("aria-pressed", "true");
    } else {
      button.setAttribute("aria-pressed", "false");
    }

    // Saat tombol diklik, kategori berubah.
    button.addEventListener("click", () => {
      activeCategory = category;

      // Perbarui tombol dan daftar menu.
      renderCategories();
      filterMenus();
    });

    categoryList.appendChild(button);
  });
}


/* =========================================
   5. MEMBUAT KARTU MENU
   ========================================= */

function createMenuCard(menu) {
  // Membuat elemen utama kartu.
  const card = document.createElement("article");
  card.className = "menu-card";

  // Area gambar dan label ketersediaan.
  const imageWrap = document.createElement("div");
  imageWrap.className = "menu-image-wrap";

  const image = document.createElement("img");
  image.className = "menu-image";
  image.src = menu.image;
  image.alt = menu.name;
  image.loading = "lazy";

  // Jika gambar gagal dimuat, tampilkan pengganti.
  image.addEventListener("error", () => {
    image.removeAttribute("src");
    image.alt = "Foto menu tidak tersedia";
    imageWrap.classList.add("image-fallback");
  }, { once: true });

  const status = document.createElement("span");
  status.className = "status-badge";

  if (menu.available) {
    status.textContent = "Tersedia";
  } else {
    status.textContent = "Habis";
    status.classList.add("unavailable");
  }

  imageWrap.append(image, status);

  // Bagian teks kartu.
  const body = document.createElement("div");
  body.className = "menu-card-body";

  const category = document.createElement("p");
  category.className = "menu-category";
  category.textContent = menu.category;

  const name = document.createElement("h3");
  name.className = "menu-name";
  name.textContent = menu.name;

  const description = document.createElement("p");
  description.className = "menu-description";
  description.textContent = menu.description;

  // Bagian harga dan stok.
  const footer = document.createElement("div");
  footer.className = "menu-card-footer";

  const price = document.createElement("span");
  price.className = "menu-price";
  price.textContent = formatRupiah(menu.price);

  const stock = document.createElement("span");
  stock.className = "menu-stock";
  stock.textContent = menu.available
    ? "Siap dipesan"
    : "Stok sedang habis";

  footer.append(price, stock);
  body.append(category, name, description, footer);
  card.append(imageWrap, body);

  return card;
}


/* =========================================
   6. MENAMPILKAN DAFTAR MENU
   ========================================= */

function renderMenus(menuData) {
  // Kosongkan daftar sebelumnya.
  menuGrid.replaceChildren();

  // Perbarui jumlah hasil yang ditampilkan.
  menuCount.textContent = `${menuData.length} menu`;

  // Tampilkan pesan jika hasil pencarian kosong.
  if (menuData.length === 0) {
    emptyState.hidden = false;
    return;
  }

  emptyState.hidden = true;

  // Buat kartu untuk setiap menu.
  const fragment = document.createDocumentFragment();

  menuData.forEach((menu) => {
    fragment.appendChild(createMenuCard(menu));
  });

  menuGrid.appendChild(fragment);
}


/* =========================================
   7. PENCARIAN DAN FILTER HARGA
   ========================================= */

function filterMenus() {
  // Ambil teks pencarian dan ubah menjadi huruf kecil.
  const keyword = searchInput.value.trim().toLocaleLowerCase("id-ID");

  // Baca batas harga yang dipilih pengguna.
  const selectedPrice = maxPriceSelect.value;

  // Filter menu berdasarkan pencarian, kategori, dan harga.
  const filteredMenus = menus.filter((menu) => {
    const matchesSearch = (
      menu.name.toLocaleLowerCase("id-ID").includes(keyword) ||
      menu.description.toLocaleLowerCase("id-ID").includes(keyword) ||
      menu.category.toLocaleLowerCase("id-ID").includes(keyword)
    );

    const matchesCategory = (
      activeCategory === "Semua" ||
      menu.category === activeCategory
    );

    const matchesPrice = (
      selectedPrice === "all" ||
      menu.price <= Number(selectedPrice)
    );

    // Menu ditampilkan jika memenuhi semua filter.
    return matchesSearch && matchesCategory && matchesPrice;
  });

  renderMenus(filteredMenus);
}


/* =========================================
   8. MENGATUR TOMBOL RESET
   ========================================= */

function resetFilters() {
  // Kembalikan semua filter ke keadaan awal.
  searchInput.value = "";
  maxPriceSelect.value = "all";
  activeCategory = "Semua";

  renderCategories();
  filterMenus();
}


/* =========================================
   9. MENJALANKAN EVENT
   ========================================= */

// Jalankan pencarian setiap kali pengguna mengetik.
searchInput.addEventListener("input", filterMenus);

// Jalankan filter ketika batas harga berubah.
maxPriceSelect.addEventListener("change", filterMenus);

// Reset semua filter ketika tombol diklik.
resetButton.addEventListener("click", resetFilters);


/* =========================================
   10. MENAMPILKAN MENU PERTAMA KALI
   ========================================= */

// Kode ini dijalankan ketika script dimuat.
renderCategories();
filterMenus();
